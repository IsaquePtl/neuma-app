{
  "name": "neuma",
  "private": true,
  "scripts": {
    "dev": "npm run dev --prefix apps/web",
    "build": "npm run build --prefix apps/web",
    "start": "npm run start --prefix apps/web",
    "lint": "npm run lint --prefix apps/web",
    "agent:dev": "cd apps/agent && .venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8765 --reload",
    "agent:test": "cd apps/agent && .venv/bin/python -m pytest -q",
    "test:e2e": "npm run test:e2e --prefix apps/web"
  }
}
