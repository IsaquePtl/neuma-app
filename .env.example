# Neuma - variaveis de ambiente
# Copia este ficheiro para .env.local e preenche com os teus valores.

# --- Supabase (Dashboard > Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-public-key>"
# Secreta - so servidor. Usada para convidar alunos (admin API).
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# --- Cal.com (embed publico, sem API key) ---
NEXT_PUBLIC_CALCOM_USERNAME="isaque-portilho-nutfa9"

# --- IA (Fase 5) - Google Gemini via Google AI Studio (tier gratuito) ---
# https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY="<gemini-api-key>"
