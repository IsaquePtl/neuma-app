# Neuma - variaveis de ambiente
# Copia este ficheiro para .env.local e preenche com os teus valores.

# --- Supabase (Dashboard > Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-public-key>"
# Secreta - so servidor. Usada para convidar alunos (admin API).
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Mentor por omissão para alunos novos (profiles.mentor_id).
# Fallback no código: isaqueportilho2014@gmail.com
DEFAULT_MENTOR_EMAIL="isaqueportilho2014@gmail.com"

# --- Cal.com ---
NEXT_PUBLIC_CALCOM_USERNAME="isaque-portilho-nutfa9"
# Slug do event type público (tem de existir em cal.com/<username>/<slug>)
NEXT_PUBLIC_CALCOM_EVENT_TYPE="neuma1-1"
# API key (Settings > Developer > API keys). Usada para sync do calendário Studio.
# Aceita também o alias legado `CAL=cal_live_...`
CAL_API_KEY=""
# Webhook: https://neuma-app-topaz.vercel.app/api/cal/webhook
# Cria o secret no Cal.com e cola aqui (e no Vercel).
CAL_WEBHOOK_SECRET=""

# --- Tally ---
# Webhook URL (mesmo endpoint para onboarding + check-in):
#   Producao: https://neuma-app-topaz.vercel.app/api/tally/webhook
#   Custom domain: https://www.comunidadeneuma.com/api/tally/webhook
#   Local: Tally NAO consegue bater em localhost — usa ngrok/cloudflared
#     ex: https://<tunnel>.ngrok-free.app/api/tally/webhook
# Configura em Tally > form 44RJrA (onboarding) > Integrations > Webhooks.
# Se activares signing secret no Tally, cola o mesmo valor numa destas vars
# (e no Vercel). Sem secret no Tally e sem estas vars, o handler aceita (dev).
TALLY_WEBHOOK_SECRET=""
TALLY_CHECKIN_WEBHOOK_SECRET=""
TALLY_ONBOARDING_WEBHOOK_SECRET=""
TALLY_ONBOARDING_FORM_ID="44RJrA"
TALLY_CHECKIN_FORM_ID="gDXd04"
NEXT_PUBLIC_TALLY_ONBOARDING_FORM_ID="44RJrA"
NEXT_PUBLIC_TALLY_ONBOARDING_URL="https://tally.so/r/44RJrA"
NEXT_PUBLIC_TALLY_CHECKIN_URL="https://tally.so/r/gDXd04"

# URL publica da app (emails + reset password + OAuth redirect)
# Local: http://localhost:3001
# Producao: https://neuma-app-topaz.vercel.app
NEXT_PUBLIC_SITE_URL="http://localhost:3001"

# --- Auth email (fase inicial: SEM confirmação) ---
# Dashboard > Authentication > Providers > Email > "Confirm email" = OFF
# (mailer_autoconfirm). Assim signUp devolve sessão e o passo 2 do signup
# (foto/bio) fica na mesma página. O código também confirma via service role
# se o toggle ainda estiver ON — mas desliga no Dashboard quando puderes:
#   https://supabase.com/dashboard/project/<PROJECT_REF>/auth/providers

# --- OAuth (Google + Apple) ---
# Configura os providers no Supabase Dashboard > Authentication > Providers.
# Redirect URLs (Authentication > URL Configuration):
#   http://localhost:3001/auth/callback
#   https://neuma-app-topaz.vercel.app/auth/callback
#
# Google Cloud Console (OAuth client Web):
#   Authorized redirect URI: https://<PROJECT_REF>.supabase.co/auth/v1/callback
#
# Apple Developer (Sign in with Apple):
#   Services ID, Key (.p8), Team ID, Key ID → colar no Supabase provider Apple

# --- Email (Resend) — opcional; sem key os emails sao ignorados em log ---
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Neuma <onboarding@resend.dev>"

# --- IA (Gemini drafts + Agent LangGraph) ---
# Feedback drafts (Next.js AI SDK): gemini-2.0-flash
# Google AI Studio: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=""
# Anthropic (agent: journey / guard / briefing) — set also on apps/agent/.env
ANTHROPIC_API_KEY=""

# --- Agent (LangGraph Python service) ---
# Local: http://127.0.0.1:8765  |  Production: injected as AGENT_INTERNAL_URL by Vercel binding
AGENT_INTERNAL_URL="http://127.0.0.1:8765"
# Shared secret between web and agent (header X-Neuma-Agent-Token)
NEUMA_AGENT_TOKEN=""
NEXT_PUBLIC_MENTOR_WHATSAPP="938909170"

# --- Stripe (modulo financeiro) ---
# Interruptor do paywall no lado da app. Sem "true"/"1" o bloqueio esta
# desligado e a app comporta-se como antes do modulo financeiro existir.
NEUMA_BILLING_ENABLED=""
# Dashboard > Developers > API keys (com Test mode LIGADO). Nunca a chave live
# neste ficheiro nem no repositorio: e publico e a Stripe revoga chaves expostas.
STRIPE_SECRET_KEY=""
# Publishable key (Dashboard > Developers > API keys). Necessária para Embedded Checkout.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Impresso pelo `stripe listen --forward-to localhost:3001/api/stripe/webhook`.
# Difere do secret mostrado no Dashboard e muda a cada sessao da CLI.
STRIPE_WEBHOOK_SECRET=""
# Price IDs recorrentes em EUR (Dashboard > Product catalog).
# Confirmar que o trimestral e "every 3 months" e nao mensal.
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_QUARTERLY=""
STRIPE_PRICE_ANNUAL=""
# Opcional: sem isto o produto "Neuma 1:1" e criado por API na primeira
# utilizacao e o id fica guardado em finance_settings.
STRIPE_PRODUCT_ONE_TO_ONE=""
# Dias de tolerancia antes de cortar o acesso a quem esta em past_due.
NEUMA_PAST_DUE_GRACE_DAYS="7"
# Cutoff do paywall. Contas criadas ANTES desta data ficam isentas.
# Com billing ligado e esta data vazia (e finance_settings.paywall_start_at null),
# um signup novo entra sem pagar. Para vender: NEUMA_BILLING_ENABLED=true,
# precos com lookup key, webhook de producao, e paywall_start_at no passado
# imediato (env em dev, finance_settings em prod). Tally/Cal sem secret rejeitam.
NEUMA_PAYWALL_START_AT=""

