R2_ACCOUNT_ID="1a0cb565744b80f278b8127a54cb21b3"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="neuma"
R2_PUBLIC_URL="https://pub-c34a4a4ac07e47c5b7013d0012d65e29.r2.dev"
R2_ENDPOINT="https://1a0cb565744b80f278b8127a54cb21b3.r2.cloudflarestorage.com"
