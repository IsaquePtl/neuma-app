# Neuma Agent (LangGraph / FastAPI)
# Copy to .env and fill values. In production these come from Vercel env.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres URI for LangGraph PostgresSaver (Supabase → Database → Connection string)
# Tables live in schema `langgraph` (migration 0023_agent_core.sql)
SUPABASE_DB_URI=

# Gemini — supervisor / router / specialists (barato; 1.5-flash já não existe na API)
# Same key as apps/web GOOGLE_GENERATIVE_AI_API_KEY
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=

# Anthropic — journey + guard (sonnet) + briefing (haiku)
ANTHROPIC_API_KEY=

# Optional per-workload overrides (provider:model)
# NEUMA_AGENT_MODEL_SUPERVISOR=google_genai:gemini-3.5-flash-lite
# NEUMA_AGENT_MODEL_JOURNEY=anthropic:claude-sonnet-4-5-20250929
# NEUMA_AGENT_MODEL_GUARD=anthropic:claude-sonnet-4-5-20250929
# NEUMA_AGENT_MODEL_BRIEFING=anthropic:claude-haiku-4-5-20251001

# Shared secret with Next.js (header X-Neuma-Agent-Token)
NEUMA_AGENT_TOKEN=
